<?xml version="1.0"?>
<robot name="scara_cell" version="1.2">
  <material name="graphite">
    <color rgba="0.16 0.18 0.21 1"/>
  </material>
  <material name="safety_orange">
    <color rgba="0.96 0.38 0.08 1"/>
  </material>
  <material name="aluminium">
    <color rgba="0.68 0.72 0.76 1"/>
  </material>
  <link name="base_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="24"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0.25" rpy="0 0 0"/><geometry><mesh filename="meshes/pedestal.obj"/></geometry><material name="graphite"/></visual>
    <collision><origin xyz="0 0 0.25" rpy="0 0 0"/><geometry><box size="0.5 0.5 0.5"/></geometry></collision>
  </link>
  <link name="shoulder">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="5"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0.14" rpy="0 0 0"/><geometry><cylinder radius="0.16" length="0.28"/></geometry><material name="safety_orange"/></visual>
    <collision><origin xyz="0 0 0.14" rpy="0 0 0"/><geometry><cylinder radius="0.16" length="0.28"/></geometry></collision>
  </link>
  <link name="upper_arm">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="3.1"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0.31 0 0" rpy="0 0 0"/><geometry><box size="0.62 0.13 0.12"/></geometry><material name="aluminium"/></visual>
    <collision><origin xyz="0.31 0 0" rpy="0 0 0"/><geometry><box size="0.62 0.13 0.12"/></geometry></collision>
  </link>
  <link name="forearm">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="2.2"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0.26 0 0" rpy="0 0 0"/><geometry><box size="0.52 0.11 0.1"/></geometry><material name="safety_orange"/></visual>
    <collision><origin xyz="0.26 0 0" rpy="0 0 0"/><geometry><box size="0.52 0.11 0.1"/></geometry></collision>
  </link>
  <link name="vertical_slide">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.4"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 -0.25" rpy="0 0 0"/><geometry><cylinder radius="0.055" length="0.5"/></geometry><material name="aluminium"/></visual>
    <collision><origin xyz="0 0 -0.25" rpy="0 0 0"/><geometry><cylinder radius="0.055" length="0.5"/></geometry></collision>
  </link>
  <link name="gripper">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.8"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/gripper.stl"/></geometry><material name="graphite"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.18 0.28 0.12"/></geometry></collision>
  </link>
  <joint name="shoulder_joint" type="revolute"><parent link="base_link"/><child link="shoulder"/><origin xyz="0 0 0.5" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-1.5708" upper="1.5708" effort="30" velocity="2"/></joint>
  <joint name="elbow_joint" type="revolute"><parent link="shoulder"/><child link="upper_arm"/><origin xyz="0 0 0.28" rpy="0 0 0"/><axis xyz="0 0 1"/><limit lower="-1.5708" upper="1.5708" effort="30" velocity="2"/></joint>
  <joint name="forearm_joint" type="fixed"><parent link="upper_arm"/><child link="forearm"/><origin xyz="0.62 0 0" rpy="0 0 0"/></joint>
  <joint name="slide_joint" type="prismatic"><parent link="forearm"/><child link="vertical_slide"/><origin xyz="0.52 0 0" rpy="0 0 0"/><axis xyz="0 0 -1"/><limit lower="0" upper="0.45" effort="80" velocity="0.6"/></joint>
  <joint name="tool_joint" type="fixed"><parent link="vertical_slide"/><child link="gripper"/><origin xyz="0 0 -0.5" rpy="0 0 0"/></joint>
</robot>
