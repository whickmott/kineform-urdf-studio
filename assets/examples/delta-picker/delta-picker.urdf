    <collision><origin xyz="0 0 -0.29" rpy="0 0 0"/><geometry><box size="0.08 0.08 0.58"/></geometry></collision>
  </link>
  <joint name="shoulder_2" type="revolute"><parent link="base_link"/><child link="upper_arm_2"/><origin xyz="-0.1400 0.2425 -0.06" rpy="0 0 0"/><axis xyz="-0.8660 -0.5000 0"/><limit lower="-1.5708" upper="1.5708" effort="30" velocity="2"/></joint>
  <link name="upper_arm_3">
