  </link>
  <joint name="shoulder_1" type="revolute"><parent link="base_link"/><child link="upper_arm_1"/><origin xyz="0.2800 0.0000 -0.06" rpy="0 0 0"/><axis xyz="0.0000 1.0000 0"/><limit lower="-1.5708" upper="1.5708" effort="30" velocity="2"/></joint>
