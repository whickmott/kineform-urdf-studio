    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/camera.obj"/></geometry><material name="camera_black"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.18 0.14 0.13"/></geometry></collision>
