<?xml version="1.0"?>
<robot name="inspection_drone" version="1.2">
  <material name="carbon">
    <color rgba="0.08 0.09 0.11 1"/>
  </material>
  <material name="propeller">
    <color rgba="0.28 0.3 0.32 0.72"/>
  </material>
  <material name="camera_black">
    <color rgba="0.04 0.04 0.05 1"/>
  </material>
  <link name="base_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="3.8"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="meshes/frame.dae"/></geometry><material name="carbon"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><box size="0.72 0.48 0.12"/></geometry></collision>
  </link>
  <link name="rotor_1">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.23" length="0.012"/></geometry><material name="propeller"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.23" length="0.012"/></geometry></collision>
  </link>
  <joint name="rotor_joint_1" type="continuous"><parent link="base_link"/><child link="rotor_1"/><origin xyz="-0.38 -0.3 0.05" rpy="0 0 0"/><axis xyz="0 0 1"/></joint>
  <link name="rotor_2">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.23" length="0.012"/></geometry><material name="propeller"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.23" length="0.012"/></geometry></collision>
  </link>
  <joint name="rotor_joint_2" type="continuous"><parent link="base_link"/><child link="rotor_2"/><origin xyz="-0.38 0.3 0.05" rpy="0 0 0"/><axis xyz="0 0 1"/></joint>
  <link name="rotor_3">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.23" length="0.012"/></geometry><material name="propeller"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.23" length="0.012"/></geometry></collision>
  </link>
  <joint name="rotor_joint_3" type="continuous"><parent link="base_link"/><child link="rotor_3"/><origin xyz="0.38 -0.3 0.05" rpy="0 0 0"/><axis xyz="0 0 1"/></joint>
  <link name="rotor_4">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.12"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.23" length="0.012"/></geometry><material name="propeller"/></visual>
