  <joint name="camera_tilt" type="revolute"><parent link="base_link"/><child link="camera"/><origin xyz="0.2 0 -0.13" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-1.2" upper="0.35" effort="4" velocity="1.5"/></joint>
