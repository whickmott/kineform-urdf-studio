<?xml version="1.0"?>
<robot name="warehouse_rover" version="1.2">
  <material name="rover_blue">
    <color rgba="0.12 0.55 0.72 1"/>
  </material>
  <material name="rubber">
    <color rgba="0.05 0.06 0.07 1"/>
  </material>
  <material name="sensor">
    <color rgba="0.82 0.88 0.92 1"/>
  </material>
  <link name="base_link">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="18"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0.28" rpy="0 0 0"/><geometry><mesh filename="package://kineform_examples/warehouse-rover/meshes/chassis.dae"/></geometry><material name="rover_blue"/></visual>
    <collision><origin xyz="0 0 0.28" rpy="0 0 0"/><geometry><box size="1 0.62 0.22"/></geometry></collision>
  </link>
  <link name="left_wheel">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.2"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><mesh filename="meshes/wheel.stl"/></geometry><material name="rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.12"/></geometry></collision>
  </link>
  <link name="right_wheel">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="1.2"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><mesh filename="meshes/wheel.stl"/></geometry><material name="rubber"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.16" length="0.12"/></geometry></collision>
  </link>
  <link name="lidar">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.35"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.09" length="0.08"/></geometry><material name="sensor"/></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><cylinder radius="0.09" length="0.08"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.37 0.18" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.37 0.18" rpy="0 0 0"/><axis xyz="0 1 0"/></joint>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar"/><origin xyz="0.25 0 0.48" rpy="0 0 0"/></joint>
</robot>
