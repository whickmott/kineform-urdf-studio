<?xml version="1.0"?>
<robot name="turtlebot_waffle_style" version="1.0">
  <material name="black">
    <color rgba="0.025 0.03 0.035 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.12 0.14 0.16 1"/>
  </material>
  <material name="aluminium">
    <color rgba="0.62 0.67 0.71 1"/>
  </material>
  <material name="blue">
    <color rgba="0.05 0.38 0.78 1"/>
  </material>
  <material name="orange">
    <color rgba="1 0.34 0.04 1"/>
  </material>
  <material name="glass">
    <color rgba="0.08 0.22 0.32 0.75"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.082" rpy="0 0 0"/>
      <mass value="2.8"/>
      <inertia
        ixx="0.024"
        ixy="0"
        ixz="0"
        iyy="0.024"
        iyz="0"
        izz="0.041"/>
    </inertial>

    <visual name="lower_deck">
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.165" length="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual name="centre_body">
      <origin xyz="0 0 0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.235 0.205 0.07"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <visual name="front_panel">
      <origin xyz="0.123 0 0.082" rpy="0 0 0"/>
      <geometry>
        <box size="0.018 0.165 0.055"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <visual name="upper_deck">
      <origin xyz="0 0 0.132" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.15" length="0.018"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.17" length="0.15"/>
      </geometry>
    </collision>
  </link>

  <link name="left_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.23"/>
      <inertia
        ixx="0.00042"
        ixy="0"
        ixz="0"
        iyy="0.00072"
        iyz="0"
        izz="0.00042"/>
    </inertial>

    <visual name="left_tyre">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.066" length="0.032"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual name="left_hub">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.036"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.066" length="0.032"/>
      </geometry>
    </collision>
  </link>

  <link name="right_wheel">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.23"/>
      <inertia
        ixx="0.00042"
        ixy="0"
        ixz="0"
        iyy="0.00072"
        iyz="0"
        izz="0.00042"/>
    </inertial>

    <visual name="right_tyre">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.066" length="0.032"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual name="right_hub">
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.036"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.066" length="0.032"/>
      </geometry>
    </collision>
  </link>

  <link name="front_caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00004"
        ixy="0"
        ixz="0"
        iyy="0.00004"
        iyz="0"
        izz="0.00004"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
  </link>

  <link name="rear_caster">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.00004"
        ixy="0"
        ixz="0"
        iyy="0.00004"
        iyz="0"
        izz="0.00004"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.025"/>
      </geometry>
    </collision>
  </link>

  <link name="sensor_platform">
    <inertial>
      <origin xyz="0 0 0.082" rpy="0 0 0"/>
      <mass value="0.62"/>
      <inertia
        ixx="0.0042"
        ixy="0"
        ixz="0"
        iyy="0.0042"
        iyz="0"
        izz="0.0068"/>
    </inertial>

    <visual name="left_front_post">
      <origin xyz="0.105 0.105 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.16"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <visual name="right_front_post">
      <origin xyz="0.105 -0.105 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.16"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <visual name="left_rear_post">
      <origin xyz="-0.105 0.105 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.16"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <visual name="right_rear_post">
      <origin xyz="-0.105 -0.105 0.08" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.009" length="0.16"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <visual name="top_plate">
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry>
        <box size="0.255 0.255 0.018"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual name="electronics">
      <origin xyz="-0.025 0 0.12" rpy="0 0 0"/>
      <geometry>
        <box size="0.145 0.12 0.055"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.165" rpy="0 0 0"/>
      <geometry>
        <box size="0.255 0.255 0.018"/>
      </geometry>
    </collision>
  </link>

  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0.038" rpy="0 0 0"/>
      <mass value="0.16"/>
      <inertia
        ixx="0.00023"
        ixy="0"
        ixz="0"
        iyy="0.00023"
        iyz="0"
        izz="0.00036"/>
    </inertial>

    <visual name="lidar_base">
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.036"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <visual name="lidar_head">
      <origin xyz="0 0 0.054" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.047" length="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>

    <visual name="lidar_window">
      <origin xyz="0 0 0.054" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.049" length="0.018"/>
      </geometry>
      <material name="glass"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.038" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.055" length="0.076"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_mount">
    <inertial>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia
        ixx="0.00012"
        ixy="0"
        ixz="0"
        iyy="0.00012"
        iyz="0"
        izz="0.00003"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.11"/>
      </geometry>
      <material name="aluminium"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.11"/>
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.14"/>
      <inertia
        ixx="0.00015"
        ixy="0"
        ixz="0"
        iyy="0.00022"
        iyz="0"
        izz="0.00024"/>
    </inertial>

    <visual name="camera_body">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.15 0.055"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>

    <visual name="left_lens">
      <origin xyz="0.037 0.045 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.018"/>
      </geometry>
      <material name="glass"/>
    </visual>

    <visual name="right_lens">
      <origin xyz="0.037 -0.045 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.018" length="0.018"/>
      </geometry>
      <material name="glass"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.065 0.15 0.055"/>
      </geometry>
    </collision>
  </link>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.035 0.012"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.045 0.035 0.012"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.178 0.066" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="8" velocity="12"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.178 0.066" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="8" velocity="12"/>
    <dynamics damping="0.02" friction="0.01"/>
  </joint>

  <joint name="front_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_caster"/>
    <origin xyz="0.125 0 0.025" rpy="0 0 0"/>
  </joint>

  <joint name="rear_caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_caster"/>
    <origin xyz="-0.125 0 0.025" rpy="0 0 0"/>
  </joint>

  <joint name="sensor_platform_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sensor_platform"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <joint name="lidar_joint" type="continuous">
    <parent link="sensor_platform"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.18" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1" velocity="10"/>
    <dynamics damping="0.01" friction="0.005"/>
  </joint>

  <joint name="camera_mount_joint" type="fixed">
    <parent link="sensor_platform"/>
    <child link="camera_mount"/>
    <origin xyz="0.09 0 0.18" rpy="0 0 0"/>
  </joint>

  <joint name="camera_tilt_joint" type="revolute">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0.125" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.8" upper="0.45" effort="2" velocity="1.5"/>
    <dynamics damping="0.04" friction="0.015"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.055 0 0.13" rpy="0 0 0"/>
  </joint>
</robot>