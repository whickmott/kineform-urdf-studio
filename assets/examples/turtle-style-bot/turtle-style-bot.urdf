<?xml version="1.0"?>
<robot name="turtle_style_bot" version="1.0">
  <material name="turtle_green"><color rgba="0.12 0.55 0.32 1"/></material>
  <material name="dark_green"><color rgba="0.05 0.24 0.14 1"/></material>
  <material name="black"><color rgba="0.035 0.04 0.045 1"/></material>
  <material name="silver"><color rgba="0.62 0.68 0.72 1"/></material>
  <material name="sensor_blue"><color rgba="0.12 0.48 0.82 1"/></material>

  <link name="base_footprint"/>

  <link name="base_link">
    <inertial><origin xyz="0 0 0.09" rpy="0 0 0"/><mass value="5.2"/><inertia ixx="0.087" ixy="0" ixz="0" iyy="0.087" iyz="0" izz="0.16"/></inertial>
    <visual><origin xyz="0 0 0.09" rpy="0 0 0"/><geometry><cylinder radius="0.31" length="0.18"/></geometry><material name="turtle_green"/></visual>
    <visual><origin xyz="0.04 0 0.19" rpy="0 0 0"/><geometry><sphere radius="0.245"/></geometry><material name="dark_green"/></visual>
    <collision><origin xyz="0 0 0.1" rpy="0 0 0"/><geometry><cylinder radius="0.31" length="0.2"/></geometry></collision>
  </link>

  <link name="left_wheel">
    <inertial><mass value="0.42"/><inertia ixx="0.0014" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0014"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.085" length="0.045"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.085" length="0.045"/></geometry></collision>
  </link>

  <link name="right_wheel">
    <inertial><mass value="0.42"/><inertia ixx="0.0014" ixy="0" ixz="0" iyy="0.0025" iyz="0" izz="0.0014"/></inertial>
    <visual><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.085" length="0.045"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0 0" rpy="1.5708 0 0"/><geometry><cylinder radius="0.085" length="0.045"/></geometry></collision>
  </link>

  <link name="rear_caster">
    <inertial><mass value="0.08"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
    <visual><geometry><sphere radius="0.035"/></geometry><material name="black"/></visual>
    <collision><geometry><sphere radius="0.035"/></geometry></collision>
  </link>

  <link name="sensor_mast">
    <inertial><origin xyz="0 0 0.12" rpy="0 0 0"/><mass value="0.28"/><inertia ixx="0.0014" ixy="0" ixz="0" iyy="0.0014" iyz="0" izz="0.0003"/></inertial>
    <visual><origin xyz="0 0 0.12" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.24"/></geometry><material name="silver"/></visual>
    <collision><origin xyz="0 0 0.12" rpy="0 0 0"/><geometry><cylinder radius="0.035" length="0.24"/></geometry></collision>
  </link>

  <link name="lidar_link">
    <inertial><mass value="0.22"/><inertia ixx="0.00045" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.0007"/></inertial>
    <visual><geometry><cylinder radius="0.075" length="0.065"/></geometry><material name="sensor_blue"/></visual>
    <visual><origin xyz="0 0 0.045" rpy="0 0 0"/><geometry><cylinder radius="0.052" length="0.028"/></geometry><material name="black"/></visual>
    <collision><geometry><cylinder radius="0.075" length="0.065"/></geometry></collision>
  </link>

  <link name="front_camera">
    <inertial><mass value="0.12"/><inertia ixx="0.00018" ixy="0" ixz="0" iyy="0.00018" iyz="0" izz="0.00018"/></inertial>
    <visual><geometry><box size="0.09 0.12 0.065"/></geometry><material name="black"/></visual>
    <visual><origin xyz="0.05 0 0" rpy="0 1.5708 0"/><geometry><cylinder radius="0.025" length="0.025"/></geometry><material name="sensor_blue"/></visual>
    <collision><geometry><box size="0.09 0.12 0.065"/></geometry></collision>
  </link>

  <joint name="base_joint" type="fixed"><parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.085" rpy="0 0 0"/></joint>
  <joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 0.325 0.085" rpy="0 0 0"/><axis xyz="0 1 0"/><limit effort="12" velocity="12"/></joint>
  <joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -0.325 0.085" rpy="0 0 0"/><axis xyz="0 1 0"/><limit effort="12" velocity="12"/></joint>
  <joint name="rear_caster_joint" type="fixed"><parent link="base_link"/><child link="rear_caster"/><origin xyz="-0.235 0 -0.055" rpy="0 0 0"/></joint>
  <joint name="mast_joint" type="fixed"><parent link="base_link"/><child link="sensor_mast"/><origin xyz="0 0 0.31" rpy="0 0 0"/></joint>
  <joint name="lidar_joint" type="continuous"><parent link="sensor_mast"/><child link="lidar_link"/><origin xyz="0 0 0.275" rpy="0 0 0"/><axis xyz="0 0 1"/><limit effort="1" velocity="8"/></joint>
  <joint name="camera_joint" type="revolute"><parent link="base_link"/><child link="front_camera"/><origin xyz="0.285 0 0.225" rpy="0 0 0"/><axis xyz="0 1 0"/><limit lower="-0.65" upper="0.35" effort="2" velocity="1.5"/></joint>
</robot>
