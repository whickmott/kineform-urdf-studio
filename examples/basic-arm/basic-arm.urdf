<?xml version="1.0"?>
<robot name="basic_robot_arm" version="1.2">
  <material name="base_blue">
    <color rgba="0.22 0.62 0.78 1"/>
  </material>
  <material name="shoulder_orange">
    <color rgba="0.86 0.46 0.22 1"/>
  </material>
  <material name="arm_green">
    <color rgba="0.34 0.76 0.55 1"/>
  </material>
  <material name="forearm_purple">
    <color rgba="0.72 0.42 0.78 1"/>
  </material>
  <material name="tool_yellow">
    <color rgba="0.88 0.72 0.25 1"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4"/>
      <inertia ixx="0.1048" ixy="0" ixz="0" iyy="0.1048" iyz="0" izz="0.2048"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.32" length="0.18"/></geometry>
      <material name="base_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.32" length="0.18"/></geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.03086666667" ixy="0" ixz="0" iyy="0.03086666667" iyz="0" izz="0.02253333333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry><box size="0.26 0.26 0.34"/></geometry>
      <material name="shoulder_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.17" rpy="0 0 0"/>
      <geometry><box size="0.26 0.26 0.34"/></geometry>
    </collision>
  </link>

  <link name="upper_arm">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia ixx="0.1053" ixy="0" ixz="0" iyy="0.1053" iyz="0" izz="0.0081"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry><box size="0.18 0.18 0.9"/></geometry>
      <material name="arm_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.45" rpy="0 0 0"/>
      <geometry><box size="0.18 0.18 0.9"/></geometry>
    </collision>
  </link>

  <link name="forearm">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.1"/>
      <inertia ixx="0.04955625" ixy="0" ixz="0" iyy="0.04955625" iyz="0" izz="0.004125"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.36" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 0.72"/></geometry>
      <material name="forearm_purple"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.36" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 0.72"/></geometry>
    </collision>
  </link>

  <link name="tool_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="0.0007933333333" ixy="0" ixz="0" iyy="0.003406666667" iyz="0" izz="0.003733333333"/>
    </inertial>
    <visual>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.16 0.12"/></geometry>
      <material name="tool_yellow"/>
    </visual>
    <collision>
      <origin xyz="0.12 0 0" rpy="0 0 0"/>
      <geometry><box size="0.32 0.16 0.12"/></geometry>
    </collision>
  </link>

  <joint name="base_yaw" type="continuous">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.09" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="25" velocity="2"/>
    <dynamics damping="0.15" friction="0.02"/>
  </joint>

  <joint name="shoulder_pitch" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.34" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.6" upper="1.6" effort="22" velocity="2"/>
    <dynamics damping="0.2" friction="0.01"/>
  </joint>

  <joint name="elbow_pitch" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0 0 0.9" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.2" upper="0.3" effort="18" velocity="2.5"/>
  </joint>

  <joint name="wrist_slide" type="prismatic">
    <parent link="forearm"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.72" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0" upper="0.25" effort="10" velocity="0.4"/>
  </joint>
</robot>
